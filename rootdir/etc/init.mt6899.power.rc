on early-init
    # boot perf. tune
    setprop vendor.all.modules.ready 1
    write /proc/sys/kernel/sched_pelt_multiplier 1
    write /proc/sys/kernel/sched_util_clamp_min_rt_default 0
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq 1000000
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_min_freq 1000000
    write /sys/devices/system/cpu/cpufreq/policy7/scaling_min_freq 1000000
    write /sys/class/devfreq/mtk-dvfsrc-devfreq/userspace/set_freq 4218000000

on boot
    chown system system /sys/devices/system/cpu/cpufreq/policy0/scaling_governor
    chmod 0660 /sys/devices/system/cpu/cpufreq/policy0/scaling_governor
    chown system system /sys/devices/system/cpu/cpufreq/policy4/scaling_governor
    chmod 0660 /sys/devices/system/cpu/cpufreq/policy4/scaling_governor
    chown system system /sys/devices/system/cpu/cpufreq/policy7/scaling_governor
    chmod 0660 /sys/devices/system/cpu/cpufreq/policy7/scaling_governor

on init
    # I/O cgroup priority
    write /dev/blkio/blkio.prio.class none-to-rt
    write /dev/blkio/blkio.prio.class promote-to-rt

    # UFS filesystem — aggressive flags for fast boot
    write /dev/sys/fs/by-name/userdata/data_io_flag 56
    write /dev/sys/fs/by-name/userdata/node_io_flag 56

    # UFS queue — high throughput during boot
    write /dev/sys/block/by-name/rootdisk/queue/iostats 0
    write /dev/sys/block/by-name/rootdisk/queue/nr_requests 256

    chown system system /sys/devices/platform/soc/13000000.mali/devfreq/13000000.mali/governor
    chmod 0660 /sys/devices/platform/soc/13000000.mali/devfreq/13000000.mali/governor

    chown system system /sys/class/devfreq/mtk-dvfsrc-devfreq/governor
    chmod 0660 /sys/class/devfreq/mtk-dvfsrc-devfreq/governor

    # CPU governors — performance during boot
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_governor performance
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_governor performance
    write /sys/devices/system/cpu/cpufreq/policy7/scaling_governor performance

    # NOTE: rate_limit_us does NOT exist under "performance" governor.
    # The "performance" governor has no tunable nodes at all — only schedutil does.
    # Removed the old broken writes to cpu0/cpu4/cpu7/cpufreq/performance/up_rate_limit_us
    # and cpu0/cpu4/cpu7/cpufreq/performance/down_rate_limit_us which do not exist.
    # These are now handled correctly in boot_completed below via schedutil nodes.

    # CPU sets
    write /dev/cpuset/foreground/cpus 0-6
    write /dev/cpuset/foreground_window/cpus 0-6
    write /dev/cpuset/background/cpus 0-3
    write /dev/cpuset/system-background/cpus 0-3
    write /dev/cpuset/top-app/cpus 0-7
    write /dev/cpuset/camera-daemon/cpus 0-7

    # Dex2oat — limit to mid cluster, avoid starving UI
    setprop dalvik.vm.dex2oat-cpu-set 0,1,2,3,4,5
    setprop dalvik.vm.dex2oat-threads 6

    # F2FS GC — aggressive during boot
    write /sys/block/mmcblk0/queue/nr_requests 64
    write /sys/block/sda/queue/scheduler mq-deadline
    write /sys/block/sda/queue/nr_requests 64
    write /sys/block/sdb/queue/nr_requests 64
    write /sys/block/sdc/queue/nr_requests 64
    write /sys/block/mmcblk0/queue/nr_requests 64
    write /dev/sys/fs/by-name/userdata/cp_interval 6000
    write /dev/sys/fs/by-name/userdata/gc_urgent_sleep_time 200

    # VM memory
    write /proc/sys/vm/dirty_expire_centisecs 3000
    write /proc/sys/vm/dirty_background_ratio 10
    write /proc/sys/vm/min_free_kbytes 27386
    write /proc/sys/vm/lowmem_reserve_ratio "0 0 0"
    write /sys/kernel/mm/transparent_hugepage/enabled "never"
    write /proc/sys/vm/kswapd_threads 1

    # Scheduler — tuned for all-big-core topology (no heterogeneous migration penalty)
    write /proc/sys/kernel/sched_migration_cost_ns 500000
    write /proc/sys/kernel/sched_latency_ns 10000000
    write /proc/sys/kernel/sched_min_granularity_ns 500000
    write /proc/sys/kernel/sched_wakeup_granularity_ns 2000000
    write /proc/sys/kernel/sched_child_runs_first 0
    write /proc/sys/kernel/sched_autogroup_enabled 1

    # GED GPU DVFS — tuned for Mali-G720 MC7 with Deferred Vertex Shading
    # Lower dvfs_loading_mode=0 allows GED to use actual GPU load, not estimated
    write /sys/kernel/ged/hal/loading_base_dvfs_step 259
    write /sys/kernel/ged/hal/dvfs_loading_mode 0
    write /sys/kernel/ged/hal/fw_idle 1
    write /sys/kernel/ged/hal/loading_stride_size 2
    write /sys/kernel/ged/hal/fallback_timing 210
    write /sys/kernel/ged/hal/fallback_interval 1
    write /sys/kernel/ged/hal/fallback_window_size 1
    write /sys/kernel/ged/hal/force_loading_base 0

    # CPU cgroup — rt
    write /dev/cpuctl/rt/cpu.uclamp.latency_sensitive 1
    write /dev/cpuctl/rt/cpu.uclamp.max 100
    write /dev/cpuctl/rt/cpu.uclamp.min 100
    write /dev/cpuctl/rt/cpu.shares 20480

    # CPU cgroup — system
    write /dev/cpuctl/system/cpu.uclamp.latency_sensitive 1
    write /dev/cpuctl/system/cpu.uclamp.min 100
    write /dev/cpuctl/system/cpu.uclamp.max 100
    write /dev/cpuctl/system/cpu.shares 20480

    # CPU cgroup — background (low shares for better power efficiency)
    write /dev/cpuctl/background/cpu.uclamp.latency_sensitive 0
    write /dev/cpuctl/background/cpu.uclamp.min 0
    write /dev/cpuctl/background/cpu.uclamp.max 50
    write /dev/cpuctl/background/cpu.shares 512

    # CPU cgroup — system-background
    write /dev/cpuctl/system-background/cpu.uclamp.latency_sensitive 0
    write /dev/cpuctl/system-background/cpu.uclamp.min 0
    write /dev/cpuctl/system-background/cpu.uclamp.max 50
    write /dev/cpuctl/system-background/cpu.shares 512

    # CPU cgroup — camera-daemon
    write /dev/cpuctl/camera-daemon/cpu.uclamp.latency_sensitive 0
    write /dev/cpuctl/camera-daemon/cpu.uclamp.max 100
    write /dev/cpuctl/camera-daemon/cpu.uclamp.min 0
    write /dev/cpuctl/camera-daemon/cpu.shares 20480

    # CPU cgroup — foreground
    write /dev/cpuctl/foreground/cpu.uclamp.latency_sensitive 1
    write /dev/cpuctl/foreground/cpu.uclamp.min 0
    write /dev/cpuctl/foreground/cpu.uclamp.max 100
    write /dev/cpuctl/foreground/cpu.shares 20480

    # CPU cgroup — foreground_window
    write /dev/cpuctl/foreground_window/cpu.uclamp.latency_sensitive 1
    write /dev/cpuctl/foreground_window/cpu.uclamp.min 0
    write /dev/cpuctl/foreground_window/cpu.uclamp.max 100
    write /dev/cpuctl/foreground_window/cpu.shares 10240

    # CPU cgroup — top-app
    write /dev/cpuctl/top-app/cpu.uclamp.latency_sensitive 1
    write /dev/cpuctl/top-app/cpu.uclamp.min 0
    write /dev/cpuctl/top-app/cpu.uclamp.max 100
    write /dev/cpuctl/top-app/cpu.shares 20480

    # CPU cgroup — nnapi-hal
    write /dev/cpuctl/nnapi-hal/cpu.uclamp.latency_sensitive 1
    write /dev/cpuctl/nnapi-hal/cpu.uclamp.max 100
    write /dev/cpuctl/nnapi-hal/cpu.uclamp.min 0
    write /dev/cpuctl/nnapi-hal/cpu.shares 20480

    # CPU cgroup — dex2oat (constrained — heavy compile tasks should not spike freq)
    write /dev/cpuctl/dex2oat/cpu.uclamp.latency_sensitive 0
    write /dev/cpuctl/dex2oat/cpu.uclamp.max 40
    write /dev/cpuctl/dex2oat/cpu.uclamp.min 0
    write /dev/cpuctl/dex2oat/cpu.shares 512


on property:sys.boot_from_charger_mode=1
    class_stop charger
    trigger late-init


on property:sys.boot_completed=1
    setprop vendor.powerhal.init 1

    # Restore PELT to normal — multiplier=1 is most power-efficient for EAS
    write /proc/sys/kernel/sched_pelt_multiplier 1

    write /sys/kernel/debug/sched/migration_cost_ns 200000

    # start cpuqos
    write /sys/devices/system/cpu/cpuqos/cpuqos_boot_complete 1

    # cpuidle governor — teo is best for all-big-core (better C-state selection than menu)
    write /sys/devices/system/cpu/cpuidle/current_governor teo

    # Switch to schedutil (EAS requires schedutil)
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_governor schedutil
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_governor schedutil
    write /sys/devices/system/cpu/cpufreq/policy7/scaling_governor schedutil

    # Grant PowerHAL write access to rate_limit_us at runtime
    chown system system /sys/devices/system/cpu/cpufreq/policy0/schedutil/rate_limit_us
    chown system system /sys/devices/system/cpu/cpufreq/policy4/schedutil/rate_limit_us
    chown system system /sys/devices/system/cpu/cpufreq/policy7/schedutil/rate_limit_us
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy0/schedutil/rate_limit_us
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy4/schedutil/rate_limit_us
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy7/schedutil/rate_limit_us

    # FIX: Write correct unified rate_limit_us AFTER schedutil is active.
    # This kernel only exposes rate_limit_us (not separate up_rate_limit_us/down_rate_limit_us).
    # 1000us default for efficiency cluster (policy0) — reduces governor overhead
    # 1000us for mid cluster (policy4) — balanced
    # 500us for prime core (policy7) — slightly faster response for single-threaded workloads
    write /sys/devices/system/cpu/cpufreq/policy0/schedutil/rate_limit_us 1000
    write /sys/devices/system/cpu/cpufreq/policy4/schedutil/rate_limit_us 1000
    write /sys/devices/system/cpu/cpufreq/policy7/schedutil/rate_limit_us 500

    write /sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq 0
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_min_freq 0
    write /sys/devices/system/cpu/cpufreq/policy7/scaling_min_freq 0
    write /sys/class/devfreq/mtk-dvfsrc-devfreq/userspace/set_freq 0

    # Mali-G720 MC7 — simple_ondemand: GPU ramps based on actual load percentage
    write /sys/devices/platform/soc/13000000.mali/devfreq/13000000.mali/governor simple_ondemand

    write /sys/class/devfreq/mtk-dvfsrc-devfreq/governor simple_ondemand

    # Mali runtime PM — enable auto power gating when GPU is idle
    write /sys/devices/platform/soc/13000000.mali/power/control auto

    # After boot_completed the PowerHAL takes over uclamp values
    write /dev/cpuctl/rt/cpu.uclamp.min 0
    write /dev/cpuctl/system/cpu.uclamp.min 0
    write /dev/cpuctl/background/cpu.uclamp.latency_sensitive 0
    write /dev/cpuctl/background/cpu.uclamp.min 0
    write /dev/cpuctl/background/cpu.uclamp.max 50
    write /dev/cpuctl/system-background/cpu.uclamp.latency_sensitive 0
    write /dev/cpuctl/system-background/cpu.uclamp.min 0
    write /dev/cpuctl/system-background/cpu.uclamp.max 50
    write /dev/cpuctl/camera-daemon/cpu.uclamp.latency_sensitive 1
    write /dev/cpuctl/foreground/cpu.uclamp.min 0
    write /dev/cpuctl/foreground_window/cpu.uclamp.min 0
    write /dev/cpuctl/foreground_window/cpu.shares 20480
    write /dev/cpuctl/top-app/cpu.uclamp.min 0
    write /dev/cpuctl/nnapi-hal/cpu.uclamp.latency_sensitive 0
    write /dev/cpuctl/nnapi-hal/cpu.shares 10240
    write /dev/cpuctl/dex2oat/cpu.uclamp.max 40

    # VM watermark — 200 scale_factor helps reclaim memory proactively, reduces stutters
    write /proc/sys/vm/watermark_scale_factor 200

    # F2FS normal operation
    write /dev/sys/fs/by-name/userdata/data_io_flag 8
    write /dev/sys/fs/by-name/userdata/node_io_flag 8
    write /dev/sys/fs/by-name/userdata/max_io_bytes 524288
    write /dev/sys/fs/by-name/userdata/min_hot_blocks 0

    # UFS queue normal
    write /dev/sys/block/by-name/rootdisk/queue/iostats 1
    write /dev/sys/block/by-name/rootdisk/queue/nr_requests 128
    write /dev/sys/block/by-name/rootdisk/queue/rq_affinity 2

on property:sys.boot_completed=1
    chmod 0664 /sys/class/usbpd/usbpd0/usbpd_verifed
    chmod 0664 /sys/class/usbpd/usbpd0/request_vdm_cmd
    chmod 0664 /sys/class/usbpd/usbpd0/verify_process
    chmod 0664 /sys/class/power_supply/usb/pd_authentication
    chmod 0664 /sys/class/power_supply/bms/authentic

service batterysecret /vendor/bin/batterysecret
    class last_start
    user root
    group system system wakelock
    disabled

on property:sys.boot_completed=1
    start batterysecret


on charger
    # USB PD permissions
    start batterysecret
    chmod 0664 /sys/class/usbpd/usbpd0/usbpd_verifed
    chmod 0664 /sys/class/usbpd/usbpd0/request_vdm_cmd
    chmod 0664 /sys/class/usbpd/usbpd0/verify_process
    chmod 0664 /sys/class/power_supply/usb/pd_authentication
    chmod 0664 /sys/class/power_supply/bms/authentic

    # F2FS charger mode
    write /dev/sys/fs/by-name/userdata/data_io_flag 8
    write /dev/sys/fs/by-name/userdata/node_io_flag 8
    write /dev/sys/fs/by-name/userdata/max_io_bytes 524288
    write /dev/sys/fs/by-name/userdata/min_hot_blocks 0

    # UFS queue charger mode
    write /dev/sys/block/by-name/rootdisk/queue/iostats 1
    write /dev/sys/block/by-name/rootdisk/queue/nr_requests 128
    write /dev/sys/block/by-name/rootdisk/queue/rq_affinity 2

    # Let governor manage CPU mins while charging
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq 0
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_min_freq 0
    write /sys/devices/system/cpu/cpufreq/policy7/scaling_min_freq 0
    write /sys/class/devfreq/mtk-dvfsrc-devfreq/userspace/set_freq 0

on property:ro.product.device=xaga
    setprop persist.vendor.accelerate.charge false

on property:ro.product.device=xagain
    setprop persist.vendor.accelerate.charge false


service vendor.gralloc-v2 /vendor/bin/hw/android.hardware.graphics.allocator-V2-service-mediatek
    class hal animation
    user system
    group graphics drmrpc
    capabilities SYS_NICE
    onrestart restart surfaceflinger
    onrestart restart vendor.hwcomposer
    onrestart restart camerahalserver
    task_profiles ProcessCapacityHigh HighPerformance