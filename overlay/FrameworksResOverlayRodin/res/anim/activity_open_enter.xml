<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:shareInterpolator="false">

    <alpha
        android:interpolator="@android:interpolator/linear"
        android:duration="120"
        android:fillBefore="true"
        android:fillAfter="true"
        android:startOffset="0"
        android:fromAlpha="0.0"
        android:toAlpha="1.0"
        android:fillEnabled="true" />

    <translate
        android:interpolator="@android:interpolator/fast_out_extra_slow_in"
        android:duration="300"
        android:fillBefore="true"
        android:fillAfter="true"
        android:startOffset="0"
        android:fromXDelta="96.0dp"
        android:toXDelta="0.0"
        android:fillEnabled="true" />

    <extend
        android:interpolator="@android:interpolator/fast_out_extra_slow_in"
        android:duration="300"
        android:startOffset="0"
        android:fromExtendLeft="96.0dp"
        android:fromExtendTop="0.0"
        android:fromExtendRight="0.0"
        android:fromExtendBottom="0.0"
        android:toExtendLeft="96.0dp"
        android:toExtendTop="0.0"
        android:toExtendRight="0.0"
        android:toExtendBottom="0.0" />
</set>
