<resources>
    <!-- Microns/ums (1000 um = 1mm) per pixel for the given device. If unspecified, UI that
         relies on this value will not be sized correctly. -->
    <item format="float" name="pixel_pitch" type="dimen">52.92</item>

   <!-- 1. The "Unlock / Charging" Text (Base layer) -->
    <!-- Pushes "Fingerprint recognized" and "Charging" text above the ripple -->
    <dimen name="keyguard_indication_margin_bottom">165.0dp</dimen>

    <!-- 2. The Music / Now Playing Info (Middle layer) -->
    <!-- Pushes song name/artist above the unlock text -->
    <dimen name="ambient_indication_margin_bottom">185.0dp</dimen>

    <!-- 4. Power Button (Alignment) -->
    <dimen name="physical_power_button_center_screen_location_y">930px</dimen>
    
</resources>