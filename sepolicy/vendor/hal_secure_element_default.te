# Allow the client to find the service
allow hal_secure_element_client hal_secure_element_service:service_manager find;

# Allow the server to add and find the service
allow hal_secure_element_server hal_secure_element_service:service_manager { add find };

# Allow binder communication between client and server (The Bridge)
binder_call(hal_secure_element_client, hal_secure_element_server)
binder_call(hal_secure_element_server, hal_secure_element_client)

typeattribute hal_secure_element_default hal_secure_element_server;

r_dir_file(hal_secure_element_default, nfc_data_vendor_file)

allow hal_secure_element_default nfc_device:chr_file rw_file_perms;
allow hal_secure_element_default teei_client_device:chr_file rw_file_perms;
