r_dir_file(hal_health_default, sysfs_power_supply)

allow hal_health_default sysfs_power_supply:dir r_dir_perms;
allow hal_health_default sysfs_power_supply:file r_file_perms;

allow hal_health sysfs_battery_supply:dir r_dir_perms;
allow hal_health sysfs_battery_supply:file rw_file_perms;
