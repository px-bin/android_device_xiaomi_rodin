type vendor_hal_displayfeature_default;
type vendor_hal_displayfeature_default_exec, exec_type, file_type, vendor_file_type;

binder_call(vendor_hal_displayfeature, hal_graphics_composer)
vndbinder_use(vendor_hal_displayfeature)

allow vendor_hal_displayfeature graphics_device:chr_file rw_file_perms;
allow vendor_hal_displayfeature graphics_device:dir r_dir_perms;
allow vendor_hal_displayfeature vndbinder_device:chr_file rw_file_perms;

