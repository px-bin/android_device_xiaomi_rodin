allow vendor_hal_displayfeature_client vendor_hal_displayfeature_service:service_manager find;
allow vendor_hal_displayfeature_client vendor_hal_framecapturemanager_xiaomi_service:service_manager find;

typeattribute vendor_hal_displayfeature_default domain;
typeattribute vendor_hal_displayfeature_default halclientdomain;
typeattribute vendor_hal_displayfeature_default halserverdomain;
typeattribute vendor_hal_displayfeature_default vendor_hal_displayfeature;
typeattribute vendor_hal_displayfeature_default vendor_hal_displayfeature_server;

init_daemon_domain(vendor_hal_displayfeature_default)

binder_call(vendor_hal_displayfeature_default, hal_allocator_server)
binder_call(vendor_hal_displayfeature_default, hal_graphics_allocator_default)
binder_call(vendor_hal_displayfeature_default, hal_graphics_composer)
binder_call(vendor_hal_displayfeature_default, surfaceflinger)
binder_call(vendor_hal_displayfeature_default, system_server)
binder_use(vendor_hal_displayfeature_default)

get_prop(vendor_hal_displayfeature_default, vendor_displayfeature_prop)
set_prop(vendor_hal_displayfeature_default, vendor_displayfeature_prop)
hal_client_domain(vendor_hal_displayfeature_default, hal_allocator)
hal_client_domain(vendor_hal_displayfeature_default, hal_graphics_allocator)
hal_client_domain(vendor_hal_displayfeature_default, hal_graphics_composer)
hal_client_domain(vendor_hal_displayfeature_default, hal_mtk_composer_ext)
hal_client_domain(vendor_hal_displayfeature_default, hal_mtk_pq)
hal_server_domain(vendor_hal_displayfeature_default, hal_graphics_composer)

hal_client_domain(vendor_hal_displayfeature_default, vendor_hal_displayfeature)
hal_server_domain(vendor_hal_displayfeature_default, vendor_hal_displayfeature)

hal_client_domain(vendor_hal_displayfeature_default, hal_allocator)
hal_client_domain(vendor_hal_displayfeature_default, hal_mtk_pq)

r_dir_file(vendor_hal_displayfeature_default, mnt_vendor_file)
r_dir_file(vendor_hal_displayfeature_default, sysfs_leds)
r_dir_file(vendor_hal_displayfeature_default, sysfs_therm)
r_dir_file(vendor_hal_displayfeature_default, vendor_displayfeature_sysfs)
r_dir_file(vendor_hal_displayfeature_default, vendor_persist_display_file)

allow vendor_hal_displayfeature_default vendor_displayfeature_device:chr_file { ioctl read write open };

allow vendor_hal_displayfeature_default persist_data_file:dir create_dir_perms;
allow vendor_hal_displayfeature_default persist_data_file:file create_file_perms;

allow vendor_hal_displayfeature_default sysfs_leds:file w_file_perms;
allow vendor_hal_displayfeature_default sysfs_therm:file w_file_perms;
allow vendor_hal_displayfeature_default vendor_display_data_file:dir create_dir_perms;
allow vendor_hal_displayfeature_default vendor_display_data_file:file create_file_perms;
allow vendor_hal_displayfeature_default vendor_displayfeature_sysfs:file w_file_perms;

set_prop(vendor_hal_displayfeature_default, vendor_displayfeature_prop)

add_service(vendor_hal_displayfeature_server, vendor_hal_displayfeature_service)
add_service(vendor_hal_displayfeature_server, vendor_hal_framecapturemanager_xiaomi_service)
allow vendor_hal_displayfeature_server vendor_hal_displayfeature_client:binder transfer;