# WiFi
wifi.interface=wlan0
wifi.supplicant_scan_interval=120
wifi.tethering.interface=ap0
wifi.direct.interface=p2p0
ro.mediatek.wlan.wsc=1
ro.mediatek.wlan.p2p=1

# IMS
ro.vendor.mtk_cta_set=1
ro.vendor.mtk_gwsd_support=1
ro.vendor.mtk_telephony_add_on_policy=0
persist.vendor.wfc.sys_wfc_support=1
persist.vendor.mtk_rtt_support=1
ro.vendor.vodata_support=1

# Audio
ro.camera.sound.forced=0
ro.audio.silent=0
ro.audio.flinger_standbytime_ms=2000
ro.audio.usb.period_us=16000

# Bluetooth Profiles
bluetooth.profile.a2dp.source.enabled=true
bluetooth.profile.avrcp.target.enabled=true
bluetooth.profile.asha.central.enabled=true
bluetooth.profile.bas.client.enabled=true
bluetooth.profile.gatt.enabled=true
bluetooth.profile.hfp.ag.enabled=true
bluetooth.profile.hid.device.enabled=true
bluetooth.profile.hid.host.enabled=true
bluetooth.profile.map.server.enabled=true
bluetooth.profile.opp.enabled=true
bluetooth.profile.pan.nap.enabled=true
bluetooth.profile.pan.panu.enabled=true
bluetooth.profile.pbap.server.enabled=true
bluetooth.profile.sap.server.enabled=true

# System
ro.property_service.async_persist_writes=true
ro.iorapd.enable=false
ro.zygote.preload.enable=0
ro.config.isolated_compilation_enabled=false
ro.malloc.impl=jemalloc
ro.nnapi.extensions.deny_on_product=true
ro.support_one_handed_mode=true
